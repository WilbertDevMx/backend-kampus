APP_NAME=Kampus
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de datos: PostgreSQL (recomendada por el geoespacial de la vista "Cerca").
# Para usar MySQL: DB_CONNECTION=mysql y DB_PORT=3306.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=kampus
DB_USERNAME=kampus
DB_PASSWORD=

# Minutos de vida de los tokens de la API (10080 = 7 días).
SANCTUM_TOKEN_EXPIRATION=10080
# Prefijo de los tokens: permite que los escáneres de secretos los detecten si se filtran.
SANCTUM_TOKEN_PREFIX=kampus_

# Orígenes del frontend autorizados por CORS, separados por comas.
FRONTEND_URLS=http://localhost:8081
# IPs de los proxies de confianza (Nginx), separadas por comas.
TRUSTED_PROXIES=127.0.0.1
# Días que se conserva storage/logs/security.log.
LOG_SECURITY_DAYS=90

# En producción: APP_ENV=production, APP_DEBUG=false y LOG_LEVEL=warning.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
PROFILE_PHOTOS_DISK=s3
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
