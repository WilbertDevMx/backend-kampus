# Entrada pública del entorno de pruebas (T-24). Caddy saca y renueva solo el certificado HTTPS de
# Let's Encrypt para el dominio de API_DOMAIN (RNF-02: todo el tráfico va por HTTPS).
{
	email {$ACME_EMAIL}
}

{$API_DOMAIN} {
	encode zstd gzip

	# WebSocket de Reverb (T-13): la app se conecta a wss://API_DOMAIN/app/{key}. Por /apps llegan los
	# eventos que publica Laravel, pero Laravel los manda directo a reverb:8080 por la red interna.
	@reverb path /app/* /apps/*
	handle @reverb {
		reverse_proxy reverb:8080
	}

	handle {
		root * /var/www/html/public
		php_fastcgi app:9000
		file_server
	}

	header {
		-Server
	}

	log {
		output stdout
		format console
	}
}

# App web (opcional): cuando el frontend genere `expo export`, copia la carpeta `dist` al servidor como
# ./web, monta ./web:/srv/app:ro en el servicio caddy, define APP_DOMAIN y quita los comentarios.
