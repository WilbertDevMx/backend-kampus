# Variables del entorno de pruebas en AWS (T-24). Copia este archivo como .env.production EN EL SERVIDOR y
# llena los valores. .env.production está en .gitignore: nunca se sube al repositorio.
# Los marcados con <...> son obligatorios.

# Dominio público de la API (sin https://) y correo para los avisos de Let's Encrypt (los usan nginx y certbot).
API_DOMAIN=<api.ejemplo.com>
ACME_EMAIL=<correo-del-equipo@ejemplo.com>

APP_NAME=Kampus
APP_ENV=production
# Se genera una vez con: docker compose -f compose.prod.yaml run --rm app php artisan key:generate --show
APP_KEY=<base64:...>
APP_DEBUG=false
APP_URL=https://<api.ejemplo.com>
# El repo todavía no trae traducciones al español (carpeta lang/): con fallback en inglés, los
# mensajes de validación salen en inglés en lugar de claves como "validation.required".
APP_LOCALE=es
APP_FALLBACK_LOCALE=en

# App web (expo export) y pantallas que abren los correos.
FRONTEND_URL=https://<app.ejemplo.com>
FRONTEND_URLS=https://<app.ejemplo.com>
PASSWORD_RESET_URL=https://<app.ejemplo.com>/auth/reset-password

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_SECURITY_DAYS=90

# Solo Nginx llega a PHP-FPM, por la red interna de Docker, y le pasa la IP real del cliente por FastCGI.
TRUSTED_PROXIES=172.16.0.0/12

# PostgreSQL del contenedor `db` (compose.prod.yaml usa estos mismos valores para crearla).
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=kampus
DB_USERNAME=kampus
DB_PASSWORD=<contraseña-larga-y-aleatoria>

SANCTUM_TOKEN_EXPIRATION=10080
SANCTUM_TOKEN_PREFIX=kampus_

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# WebSocket (T-13). Laravel publica los eventos por la red interna (reverb:8080) y la app se conecta a
# wss://API_DOMAIN/app/{REVERB_APP_KEY}. Genera ID, KEY y SECRET aleatorios.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=<id>
REVERB_APP_KEY=<key>
REVERB_APP_SECRET=<secret>
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Host de la app web que puede abrir el WebSocket.
REVERB_ALLOWED_ORIGINS=<app.ejemplo.com>

# Videollamadas (T-19): proyecto de LiveKit Cloud. LIVEKIT_URL es la dirección wss://<proyecto>.livekit.cloud.
# La API secret solo va en el servidor; la app recibe tokens de 15 minutos.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Imágenes en S3 (bucket privado; las URLs firmadas vencen a los 15 minutos). Usa un usuario de IAM con
# permiso solo sobre este bucket, no las llaves de la cuenta.
FILESYSTEM_DISK=local
PROFILE_PHOTOS_DISK=s3
GROUP_IMAGES_DISK=s3
AWS_ACCESS_KEY_ID=<access-key-del-usuario-iam>
AWS_SECRET_ACCESS_KEY=<secret-del-usuario-iam>
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=<nombre-del-bucket>
AWS_USE_PATH_STYLE_ENDPOINT=false

# Correo con Resend por SMTP: el usuario es literalmente "resend" y la contraseña es la API key
# (solo con permiso de envío). El remitente tiene que ser de un dominio verificado en Resend.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USERNAME=resend
MAIL_PASSWORD=<api-key-de-resend>
MAIL_FROM_ADDRESS=<no-responder@ejemplo.com>
MAIL_FROM_NAME="Kampus"

# Datos de demostración (T-34). Solo en el entorno de pruebas: en una producción real se queda en false.
# Con true, `php artisan db:seed --class=DemoSeeder --force` crea los estudiantes ficticios.
DEMO_DATA_ENABLED=false
# Contraseña de las cuentas de demostración. Si se deja vacía, cada corrida genera una y la muestra.
DEMO_PASSWORD=
